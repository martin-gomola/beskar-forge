# Copy to config/.env (keep .env out of git). Fill in real values before deploy.
# cp config/env.example config/.env
#
# Run `make doctor` after editing to validate the shape of these values.

# =============================================================================
# SECURITY (Required for public deployments)
# =============================================================================

# API key for external (non-browser) requests like curl scripts and CI hooks.
# Browser requests from CORS_ORIGINS bypass this check automatically.
# This is not user authentication. Add application auth for private user data.
# Generate: openssl rand -hex 32
APP_API_KEY=

# CORS allow-list: comma-separated FULL ORIGINS (scheme + host[:port]).
# No trailing slashes. MUST include every public origin browsers load from.
#
# IMPORTANT for public deployments:
#   - Missing entries cause FastAPI to return 403/400 on every browser
#     request and python-socketio to reject every WebSocket. The UI then
#     fails silently with "loading forever" symptoms.
#   - Example for a deployed app:
#     CORS_ORIGINS=http://localhost:3020,http://localhost:8082,https://your-app.example.com
CORS_ORIGINS=http://localhost:3020,http://localhost:8082

# Trusted hosts for FastAPI's TrustedHostMiddleware: comma-separated
# BARE HOSTNAMES (no scheme, no port, no path). Each public hostname in
# CORS_ORIGINS should also appear here.
#   - Example for a deployed app:
#     TRUSTED_HOSTS=localhost,127.0.0.1,your-app.example.com
TRUSTED_HOSTS=localhost,127.0.0.1

# =============================================================================
# GENERAL
# =============================================================================

# Logging level
LOG_LEVEL=INFO

# Host port mappings. Override if these are taken on the deploy host.
DEV_FRONTEND_PORT=3020
BACKEND_PORT=8062
FRONTEND_PORT=8082

# Optional: uncomment to override the directory-derived Compose project name.
# COMPOSE_PROJECT_NAME=my-app

# =============================================================================
# DEPLOY TARGETS
# =============================================================================

# Render.com (see docs/RENDER.md):
#   - Don't set these in config/.env; declare them in render.yaml instead so
#     the blueprint is the source of truth. Listed here for reference only.
#
#   PORT                       Injected by Render at runtime (Dockerfile honors it).
#   VITE_API_URL               Build-time API base URL for the static frontend.
